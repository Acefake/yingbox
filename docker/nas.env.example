# 跟随 NAS 稳定版，每天北京时间 04:00 自动检查更新。
YINGBOX_VERSION=stable
PUID=1000
PGID=1000
YINGBOX_MEDIA_DIR=/volume1/video

# 下列项目按需填写，未填写时使用 Compose 中的默认值。
# YINGBOX_IMAGE=ghcr.io/acefake/yingbox-nas
# YINGBOX_CONFIG_DIR=./yingbox/config
# YINGBOX_CACHE_DIR=./yingbox/cache
# YINGBOX_BIND=127.0.0.1
# YINGBOX_PORT=31480
# YINGBOX_SERVER_TOKEN=
# YINGBOX_PUBLIC_ORIGIN=https://media.example.com
