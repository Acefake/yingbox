{
  "name": "yingbox",
  "version": "1.0.0",
  "description": "影盒 - 影视资源管理与在线观看",
  "main": "./out/main/index.js",
  "author": "影盒团队",
  "homepage": "https://github.com/Acefake/yingbox",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache --max-warnings 0 . && node scripts/check-size.mjs --strict",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:tests": "vue-tsc --noEmit -p tsconfig.tests.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:tests",
    "start": "node scripts/dev-app.mjs preview",
    "dev:web": "vite --config vite.config.web.ts",
    "build:web": "vite build --config vite.config.web.ts",
    "preview:web": "vite preview --config vite.config.web.ts",
    "dev:server": "tsx watch --tsconfig tsconfig.node.json src/server/index.ts",
    "build:server": "vite build --config vite.config.server.ts",
    "start:server": "node --disable-warning=ExperimentalWarning out/server/server.js",
    "smoke:server": "node scripts/smoke-server.mjs",
    "fetch:mpv": "node scripts/fetch-mpv.mjs",
    "dev": "node scripts/dev-app.mjs dev",
    "build:nocheck": "electron-vite build",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run fetch:mpv && npm run build:nocheck && electron-builder --dir",
    "build:win": "npm run fetch:mpv && npm run build:nocheck && electron-builder --win zip",
    "build:win:full": "npm run fetch:mpv && npm run build:nocheck && electron-builder --win",
    "build:mac": "npm run build:nocheck && electron-builder --mac",
    "build:linux": "npm run build:nocheck && electron-builder --linux",
    "check": "bash scripts/check-issues.sh",
    "check:style": "node scripts/style-tokens.mjs",
    "check:case": "node scripts/check-import-case.mjs",
    "check:size": "node scripts/check-size.mjs --strict",
    "check:copy": "node scripts/check-copy.mjs",
    "perf:static": "node scripts/measure-static.mjs",
    "check:fix": "bash scripts/check-issues.sh && pnpm lint --fix",
    "test": "vitest run",
    "test:affected": "node scripts/test-affected.mjs",
    "test:watch": "vitest",
    "bench:library": "tsx scripts/bench-library.ts",
    "bench:identify": "tsx scripts/bench-identify.ts"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/resize": "^2.1.1",
    "@jsquash/webp": "^1.5.0",
    "@vueuse/core": "^14.2.1",
    "artplayer": "^5.4.0",
    "cheerio": "^1.2.0",
    "crypto-js": "^4.2.0",
    "electron-updater": "^6.3.9",
    "hls.js": "^1.6.16",
    "onnxruntime-node": "1.23.2",
    "opencc-js": "^1.4.2",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^22.16.5",
    "@vitejs/plugin-vue": "^6.0.6",
    "autoprefixer": "^10.4.21",
    "electron": "^37.2.3",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "eslint": "^9.31.0",
    "eslint-plugin-vue": "^10.3.0",
    "jsdom": "26.1.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^5.0.2",
    "vue": "^3.5.17",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.0.3"
  }
}
